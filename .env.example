# Environment Variables for Kaveri Restaurant / FoodNest
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Database
DATABASE_URL=jdbc:mysql://localhost:3306/kaveridb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://thekaveri.com,https://www.thekaveri.com

# Rate Limiting
RATELIMIT_ENABLED=true

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Set to true for local testing without live Razorpay credentials
RAZORPAY_MOCK_ENABLED=false

# Meta WhatsApp Business Platform Cloud API
# (Get from https://developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_API_TOKEN=your_meta_system_user_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kaveri_whatsapp_verify_token_est1947
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_RESTAURANT_PHONE=918235520520
WHATSAPP_RESTAURANT_NAME="Kaveri Restaurant Kitchen"
# Set to true for local testing/dev without Meta Cloud API account
WHATSAPP_MOCK_ENABLED=true

# Docker MySQL
MYSQL_ROOT_PASSWORD=strongrootpassword
MYSQL_USER=foodnest
MYSQL_PASSWORD=foodnest123

# Upload directory
UPLOAD_DIR=uploads
